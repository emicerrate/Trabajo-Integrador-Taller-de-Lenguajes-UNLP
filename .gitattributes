# Normalize line endings for all text files
* text=auto

# Explicitly enforce LF endings for Unix-friendly files
*.sh     text eol=lf
*.py     text eol=lf
*.ipynb  text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.json   text eol=lf

# Optional: keep Windows-style endings for Windows-specific files
*.bat    text eol=crlf
*.ps1    text eol=crlf